# Copy to .env and edit. Every key maps to a field in app/config.py.

# --- HTTP ---
HOST=0.0.0.0
PORT=8080

# --- Panel (THE switch) ---
# Which Inky Impression this drives. This one value picks the driver, resolution,
# button-C GPIO, busy-wait ceiling, and Home-Assistant identity (see app/panels.py):
#   impression_73 -> 7.3", 800x480, driver InkyE673,    button C = GPIO 16, ceiling 40s
#   impression_13 -> 13.3", 1600x1200, driver InkyEL133UF1, button C = GPIO 25, ceiling 50s
PANEL=impression_73

# --- Display ---
# 1 = no hardware (dev/CI): only writes data/latest.png. 0 = drive the panel.
INKY_MOCK=0
INKY_AUTO_DETECT=1
INKY_SATURATION=0.5
OUTPUT_DIR=/data
# 1 = HTTP request blocks until the refresh completes (tens of seconds); 0 = return now.
DISPLAY_WAIT_DEFAULT=0
# Optional: override the panel's busy-wait ceiling (seconds). Unset = per-panel default.
# BUSY_WAIT_CEILING=40

# --- Dithering (epaper-dithering) ---
DITHER_COLOR_SCHEME=BWGBRY
# Optional measured palette (overrides the scheme), e.g. SPECTRA_7_3_6COLOR_V2.
DITHER_PALETTE=
DITHER_MODE=JARVIS_JUDICE_NINKE
DITHER_EXPOSURE=1.0
DITHER_SATURATION=1.0
DITHER_SHADOWS=0.0
DITHER_HIGHLIGHTS=0.0
DITHER_TONE=auto
DITHER_GAMUT=auto

# --- Device settings: SEEDS only (app/prefs.py) ---
# These seed <OUTPUT_DIR>/prefs.json the FIRST run only. After that the stored file
# wins, because that is what Home Assistant edits — a deploy must not silently revert
# a choice made from HA. Delete prefs.json to re-seed. Change them live instead with
# the Mounting / Fit / Dithering / Auto-fit selects in HA, or PATCH /prefs.
# How the frame is physically mounted.
DEFAULT_ORIENTATION=landscape
# Placement for an incoming photo: auto | cover | contain. auto = cover while it
# crops less than AUTO_FIT_MAX_CROP, contain otherwise — so a portrait photo on a
# landscape frame is padded instead of being cropped in half.
DEFAULT_FIT=auto
# 0.30 on a 4:3 panel: 4:3 (0%), 3:2 (11%) and 16:9 (25%) get cover; a 2:1 panorama
# (33%) and a 3:4 portrait photo (44%) get contain.
AUTO_FIT_MAX_CROP=0.30

# --- Absolute URL other machines use to reach this service ---
# Baked into HA's `image` entity so it can fetch the current frame. Empty = autodetect
# the primary LAN address. Set it for Tailscale / a reverse proxy.
PUBLIC_BASE_URL=

# --- Photo library ---
# Keeps every photo sent to the frame under OUTPUT_DIR (photos/ renders/ thumbs/ +
# library.json) so it can be shown again: GET /library, POST /display/library/<id>,
# POST /display/nav?direction=next|prev|random.
LIBRARY_ENABLED=1
# Oldest entries are pruned past this. Budget ~1 MB original + ~0.3 MB render +
# ~10 KB thumb each, so 300 is roughly 400 MB on the 13.3" (less on the 7.3").
LIBRARY_MAX_ITEMS=300
# Archived originals are downscaled to this multiple of the panel's long edge
# (2.0 -> 3200 px on the 13.3"). Big enough to re-dither well, small enough not to
# hoard full-size phone photos.
LIBRARY_ORIGINAL_MAX_SCALE=2.0
LIBRARY_THUMB_SIZE=320
LIBRARY_JPEG_QUALITY=90

# --- POST /display/url (fetch an image by URL and show it) ---
URL_FETCH_MAX_BYTES=33554432
URL_FETCH_TIMEOUT=15.0

# --- Buttons (BCM GPIO) ---
# A/B/D are the same on every Impression. Button C is derived from PANEL (16 on the
# 7.3", 25 on the 13.3") — only uncomment BUTTON_GPIO_C to force a non-default wiring.
BUTTON_GPIO_A=5
BUTTON_GPIO_B=6
# BUTTON_GPIO_C=16
BUTTON_GPIO_D=24
BUTTON_DEBOUNCE_MS=200

# --- MQTT (your Home Assistant / Mosquitto broker) ---
MQTT_ENABLED=1
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=inky-frame
MQTT_BASE_TOPIC=inky-frame
MQTT_QOS=0
# Home Assistant entities come from the custom integration in homeassistant/, not from
# discovery configs published by this service. The prefix is still used: the bridge
# clears the configs it used to publish under it. (MQTT_DISCOVERY is gone; a leftover
# value in .env is ignored.)
MQTT_DISCOVERY_PREFIX=homeassistant

# --- Device identity (shown in Home Assistant) ---
# Derived from PANEL (inky_frame_73 / "Inky Frame 7.3", or inky_frame_13 / "Inky
# Frame 13.3"). Uncomment to override. NOTE: changing DEVICE_ID registers a NEW
# device in HA — any automations bound to the old id must be re-pointed.
# DEVICE_ID=inky_frame_73
# DEVICE_NAME=Inky Frame 7.3

# --- Guest Wi-Fi QR (POST /display/dashboard?name=guest_wifi) ---
# The guest network's SSID + password, encoded into a connect-QR shown on the panel.
# SECURITY: WPA (covers WPA2/WPA3) or `nopass` for an open network.
GUEST_WIFI_SSID=
GUEST_WIFI_PASSWORD=
GUEST_WIFI_SECURITY=WPA
